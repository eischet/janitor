<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>

    <parent>
        <groupId>com.eischet.root</groupId>
        <artifactId>lib-public</artifactId>
        <version>1.0.15</version>
    </parent>

    <groupId>com.eischet.janitor</groupId>
    <artifactId>janitor-project</artifactId>
    <version>${revision}</version>

    <name>Janitor</name>
    <description>A simple scripting language for the JVM.</description>
    <url>https://github.com/eischet/janitor</url>

    <properties>
        <!-- project revision -->
        <revision>0.9.70-SNAPSHOT</revision>

        <!-- project settings -->
        <maven.plugin.validation>VERBOSE</maven.plugin.validation>

        <!-- dependency versions -->
        <deps.autoservice>1.1.1</deps.autoservice>
        <deps.jansi-and-jline>4.4.8</deps.jansi-and-jline>

        <maven.compiler.release>21</maven.compiler.release>

        <!-- assorted external dependencies -->
        <deps.bouncycastle>1.86</deps.bouncycastle>
        <deps.docusign>6.9.0</deps.docusign>
        <deps.azure-identity>1.18.7</deps.azure-identity>
        <deps.azure-core-http-jdk-httpclient>1.2.0</deps.azure-core-http-jdk-httpclient>
        <deps.mcp>2.1.0</deps.mcp>
        <deps.jetty>12.1.14</deps.jetty>

    </properties>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Stefan Eischet</name>
            <email>stefan@eischet.net</email>
            <organization>Eischet Software e.K.</organization>
            <organizationUrl>https://www.eischet.com/</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/eischet/janitor.git</connection>
        <developerConnection>scm:git:ssh://github.com:eischet/janitor.git</developerConnection>
        <url>https://github.com/eischet/janitor/tree/main</url>
    </scm>

    <modules>
        <module>janitor-toolbox</module>
        <module>janitor-api</module>
        <module>janitor-lang</module>
        <module>janitor-demo</module>
        <module>janitor-jsr223</module>
        <module>janitor-maven-plugin</module>
        <module>janitor-repl</module>
        <module>janitor-logging</module>
        <module>janitor-dbxs</module>
        <module>janitor-orm</module>
        <module>janitor-orm-rest</module>
        <module>janitor-orm-rest-servlet</module>
        <module>janitor-generator</module>
        <module>janitor-modules</module>
        <module>janitor-modules-common</module>
        <module>janitor-docs</module>
        <module>janitor-tests</module>
    </modules>


    <build>
        <pluginManagement>
            <!-- lock down plugin versions -->
            <plugins>
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <!-- see http://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_maven-plugin_packaging -->
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-plugin-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-invoker-plugin</artifactId>
                    <version>3.10.1</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <configuration>
                            <excludePackageNames>com.eischet.janitor.lang</excludePackageNames>
                            <!--
                                while we should strive for complete JavaDoc, some classes simply do not have it, like the
                                generated code from ANTLR, and there is simply no point in copying @Override methods'
                                JavaDoc from the interface to the implementing class everywhere.
                            -->
                            <doclint>all,-missing</doclint>
                        </configuration>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>

        </plugins>
    </build>


    <dependencyManagement>
        <dependencies>
            <!-- as suggessted by https://github.com/junit-team/junit-examples/blob/main/junit-jupiter-starter-maven/pom.xml -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-docs</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-dbxs</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-logging</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-lang</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-toolbox</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-orm</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-orm-rest</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-orm-rest-servlet</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>6.1.0</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-generator</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- most modules are included in janitor-modules-common -->
            <dependency>
                <groupId>com.eischet.janitor</groupId>
                <artifactId>janitor-modules-common</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- these modules are not included in janitor-modules-common because of heavier dependency sets,
                 so users should include them individually as needed -->
            <dependency>
                <groupId>com.eischet.janitor.modules</groupId>
                <artifactId>commonmark</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor.modules</groupId>
                <artifactId>mustang</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor.modules</groupId>
                <artifactId>msgraph</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor.modules</groupId>
                <artifactId>docusign</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor.modules</groupId>
                <artifactId>pdf</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor.modules</groupId>
                <artifactId>mcp</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.eischet.janitor.modules</groupId>
                <artifactId>httpclient</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- external dependencies -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>2.14.0</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${deps.slf4j}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-jdk14</artifactId>
                <version>${deps.slf4j}</version>
            </dependency>
            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service-annotations</artifactId>
                <version>${deps.autoservice}</version>
            </dependency>
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline</artifactId>
                <version>${deps.jansi-and-jline}</version>
            </dependency>
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jansi</artifactId>
                <version>${deps.jansi-and-jline}</version>
            </dependency>

            <dependency>
                <groupId>com.eischet</groupId>
                <artifactId>jul-rolling-logs</artifactId>
                <version>1.0.0</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.22.4</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.22.3</version>
                <scope>compile</scope>
            </dependency>
            <!-- pinned to match jackson-databind; mcp-core would otherwise pull in an older one -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.22</version>
            </dependency>

            <!-- pinned to match jackson-databind; json-schema-validator (via mcp-json-jackson2) would otherwise pull in 2.18 -->
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>2.22.3</version>
            </dependency>

            <!-- for the mcp module -->
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-core</artifactId>
                <version>${deps.mcp}</version>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-json-jackson2</artifactId>
                <version>${deps.mcp}</version>
            </dependency>
            <!-- embedded servlet container for the MCP server in McpModuleIT (tests only) -->
            <dependency>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-servlet</artifactId>
                <version>${deps.jetty}</version>
            </dependency>

            <!-- for the pdf module -->
            <dependency>
                <groupId>com.github.librepdf</groupId>
                <artifactId>openpdf</artifactId>
                <version>3.0.5</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>deploy-internal</id>
            <distributionManagement>
                <repository>
                    <id>repo-eischet-releases</id>
                    <name>Eischet Software Repository</name>
                    <url>https://repo.srv.eischet.net/releases</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <snapshotRepository>
                    <id>repo-eischet-snapshots</id>
                    <name>Eischet Software Repository</name>
                    <url>https://repo.srv.eischet.net/snapshots</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>


</project>