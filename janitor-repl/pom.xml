<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.eischet.janitor</groupId>
        <artifactId>janitor-project</artifactId>
        <version>${revision}</version>
    </parent>

    <packaging>jar</packaging>
    <artifactId>janitor-repl</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>This is an interactive REPL, a.k.a. "read-eval-print-loop", where you can execute Janitor code and
        expressions.
    </description>

    <properties>
        <deps.install4j>13.1</deps.install4j>
        <!-- only run Install4j when requested via profile: -->
        <install4j.skip>true</install4j.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-lang</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-modules-common</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>mustang</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>docusign</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>commonmark</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>pdf</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-generator</artifactId>
        </dependency>

        <!-- to satisfy logging needs -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>janitor</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>com.eischet.janitor.standalone.repl.JanitorStandaloneRepl</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <descriptors>
                        <descriptor>assembly.xml</descriptor>
                    </descriptors>
                 </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id> <!-- this is used for inheritance merges -->
                        <phase>package</phase> <!-- bind to the packaging phase -->
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>



            <plugin>
                <groupId>com.install4j</groupId>
                <artifactId>install4j-maven</artifactId>
                <version>${deps.install4j}</version>
                <executions>
                    <execution>
                        <id>install4j</id>
                        <phase>package</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <skip>${install4j.skip}</skip>
                            <projectFile>./janitor.install4j</projectFile>
                            <release>${revision}</release>
                            <!-- <destination>./target</destination> -->
                            <!-- <buildSelected>true</buildSelected> -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>


    </build>

    <profiles>
        <profile>
            <id>install4j</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <install4j.skip>false</install4j.skip>
            </properties>
        </profile>
    </profiles>


</project>