<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.eischet.janitor</groupId>
        <artifactId>janitor-project</artifactId>
        <version>${revision}</version>
    </parent>

    <packaging>jar</packaging>
    <artifactId>janitor-tests</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Unit tests of the Janitor language</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip> <!-- this module contains unit tests only -->
        <maven.install.skip>true</maven.install.skip>
        <jmh.version>1.37</jmh.version>
        <!-- what the "bench" profile passes to JMH: a benchmark name pattern, optionally followed by JMH options -->
        <jmh.args>Benchmark</jmh.args>
        <!-- see the "coverage" and "mutation" profiles below -->
        <jacoco.version>0.8.16</jacoco.version>
        <pitest.version>1.30.1</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-lang</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-toolbox</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-orm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-orm-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-orm-rest-servlet</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-generator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-modules-common</artifactId>
        </dependency>
        <!-- the language reference: ReferenceDocsTest checks that the packaged index matches docs/reference -->
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-docs</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>commonmark</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>docusign</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>mustang</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>msgraph</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>
        <!-- McpModuleIT runs a real MCP server (the server part of mcp-core) in an embedded Jetty -->
        <dependency>
            <groupId>org.eclipse.jetty.ee10</groupId>
            <artifactId>jetty-ee10-servlet</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>pdf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>excel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor.modules</groupId>
            <artifactId>word</artifactId>
        </dependency>
        <dependency>
            <groupId>com.eischet.janitor</groupId>
            <artifactId>janitor-dbxs</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Gson is the reference implementation that the JSON stream tests compare against -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.5.252</version>
            <scope>test</scope>
        </dependency>
        <!-- benchmarks (*Benchmark.java), see the "bench" profile below -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>


    </dependencies>

    <!-- this module only contains tests: there is no JAR to build (and none to sign, install or deploy) -->
    <build>
        <plugins>
            <!-- the JMH annotation processor generates the benchmark code; since JDK 23, processors must be named explicitly -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skipIfEmpty>true</skipIfEmpty>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-gpg-plugin</artifactId>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <!--
                Integration tests (*IT.java): slow ones, and ones that need more than the JVM, e.g. a local HTTP server. They do not run with
                "mvn test" or "mvn package", only from "mvn verify" on, so also before every install and deploy.
            -->
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Line and branch coverage of the whole test suite (unit and integration tests), aggregated over all modules
            this one depends on, so it shows how well janitor-lang, janitor-api etc. are tested:
            mvn -pl janitor-tests -am -Pcoverage verify
            Report: janitor-tests/target/site/jacoco-aggregate/index.html
        -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                                <configuration>
                                    <includeCurrentProject>true</includeCurrentProject>
                                    <excludes>
                                        <!-- generated by ANTLR from Janitor.g4 -->
                                        <exclude>com/eischet/janitor/lang/Janitor*</exclude>
                                        <!-- the benchmarks and the code JMH generates for them -->
                                        <exclude>com/eischet/janitor/benchmarks/**</exclude>
                                        <exclude>**/jmh_generated/**</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Mutation tests: PIT changes the interpreter's byte code in small ways and checks that some test fails each time.
            Slow, as it runs the covering tests once per mutation.
            mvn -pl janitor-tests -am -Pmutation test
            Narrow it down with e.g. -Dpit.targetClasses=com.eischet.janitor.runtime.*
            Report: janitor-tests/target/pit-reports/index.html
        -->
        <profile>
            <id>mutation</id>
            <properties>
                <pit.targetClasses>com.eischet.janitor.compiler.*,com.eischet.janitor.runtime.*,com.eischet.janitor.env.*,com.eischet.janitor.api.*</pit.targetClasses>
            </properties>
            <build>
                <plugins>
                    <!-- PIT runs the tests itself -->
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <executions>
                            <execution>
                                <id>pit</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- the code under test lives in the modules this one depends on -->
                            <crossModule>true</crossModule>
                            <targetClasses>${pit.targetClasses}</targetClasses>
                            <excludedClasses>
                                <param>com.eischet.janitor.lang.Janitor*</param>
                            </excludedClasses>
                            <targetTests>
                                <param>com.eischet.janitor.*</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>*IT</param>
                                <param>com.eischet.janitor.benchmarks.*</param>
                            </excludedTestClasses>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Runs the JMH benchmarks instead of the tests, e.g.
            mvn -pl janitor-tests -am -Pbench -DskipTests test
            mvn -pl janitor-tests -am -Pbench -DskipTests test "-Djmh.args=JsonStreamsBenchmark.read -p impl=native"
        -->
        <profile>
            <id>bench</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>jmh</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <classpathScope>test</classpathScope>
                                    <commandlineArgs>-cp %classpath org.openjdk.jmh.Main ${jmh.args}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>