{
	"scopeName": "source.janitor",
	"fileTypes": [
		"janitor"
	],
	"name": "Janitor",
	"patterns": [
		{
			"name": "comment.line.shebang.janitor",
			"match": "\\A#.*$"
		},
		{
			"name": "comment.block.janitor",
			"begin": "/\\*",
			"end": "\\*/"
		},
		{
			"name": "comment.line.double-slash.janitor",
			"match": "//.*$"
		},
		{
			"name": "string.quoted.triple.janitor",
			"begin": "\"\"\"",
			"end": "\"\"\"",
			"patterns": [
				{
					"name": "constant.character.escape.janitor",
					"match": "\\\\(?:[btnfr\"'\\\\/]|[0-3]?[0-7]?[0-7]|u+[0-9a-fA-F]{4})"
				},
				{
					"name": "invalid.illegal.escape.janitor",
					"match": "\\\\."
				}
			]
		},
		{
			"name": "string.quoted.triple.janitor",
			"begin": "'''",
			"end": "'''",
			"patterns": [
				{
					"name": "constant.character.escape.janitor",
					"match": "\\\\(?:[btnfr\"'\\\\/]|[0-3]?[0-7]?[0-7]|u+[0-9a-fA-F]{4})"
				},
				{
					"name": "invalid.illegal.escape.janitor",
					"match": "\\\\."
				}
			]
		},
		{
			"name": "string.quoted.double.janitor",
			"begin": "\"",
			"end": "\"|$",
			"patterns": [
				{
					"name": "constant.character.escape.janitor",
					"match": "\\\\(?:[btnfr\"'\\\\/]|[0-3]?[0-7]?[0-7]|u+[0-9a-fA-F]{4})"
				},
				{
					"name": "invalid.illegal.escape.janitor",
					"match": "\\\\."
				}
			]
		},
		{
			"name": "string.quoted.single.janitor",
			"begin": "'",
			"end": "'|$",
			"patterns": [
				{
					"name": "constant.character.escape.janitor",
					"match": "\\\\(?:[btnfr\"'\\\\/]|[0-3]?[0-7]?[0-7]|u+[0-9a-fA-F]{4})"
				},
				{
					"name": "invalid.illegal.escape.janitor",
					"match": "\\\\."
				}
			]
		},
		{
			"name": "string.regexp.janitor",
			"match": "(?<![\\w$])re/(?:\\\\/|[^\\r\\n])*?/"
		},
		{
			"name": "constant.other.datetime.janitor",
			"match": "@\\d{4}-\\d?\\d-\\d?\\d(?:-\\d\\d:\\d\\d(?::\\d\\d)?)?|@(?:today|now)\\b"
		},
		{
			"name": "constant.other.duration.janitor",
			"match": "@\\d+(?:y|mo|w|d|h|mi|s)"
		},
		{
			"name": "invalid.illegal.janitor",
			"match": "@[\\w$]*"
		},
		{
			"name": "constant.numeric.janitor",
			"match": "(?<![\\w$])(?:0[xX][0-9a-fA-F](?:[0-9a-fA-F_]*[0-9a-fA-F])?|0[bB][01](?:[01_]*[01])?)\\b"
		},
		{
			"name": "constant.numeric.janitor",
			"match": "(?<![\\w$])(?:\\d(?:[\\d_]*\\d)?\\.(?:\\d(?:[\\d_]*\\d)?)?|\\.\\d(?:[\\d_]*\\d)?)(?:[eE][+-]?\\d(?:[\\d_]*\\d)?)?[fFdD]?|(?<![\\w$.])\\d(?:[\\d_]*\\d)?(?:[eE][+-]?\\d(?:[\\d_]*\\d)?[fFdD]?|[fFdD])\\b"
		},
		{
			"name": "invalid.illegal.octal.janitor",
			"match": "(?<![\\w$.])0_*[0-7][0-7_]*\\b"
		},
		{
			"name": "constant.numeric.janitor",
			"match": "(?<![\\w$.])(?:0|[1-9](?:[\\d_]*\\d)?)\\b"
		},
		{
			"match": "\\b(function)\\s+([\\w$]+)",
			"captures": {
				"1": {
					"name": "storage.type.function.janitor"
				},
				"2": {
					"name": "entity.name.function.janitor"
				}
			}
		},
		{
			"comment": "after '.' or '?.' every name is a plain member name, even 'from', 'to' or 'in'",
			"match": "(\\??\\.)\\s*([\\w$]+)",
			"captures": {
				"1": {
					"name": "punctuation.accessor.janitor"
				},
				"2": {
					"name": "variable.other.member.janitor"
				}
			}
		},
		{
			"name": "keyword.control.janitor",
			"match": "(?<![\\w$])(?:if|then|else|for|from|to|while|do|break|continue|return|try|catch|finally|throw)(?![\\w$])"
		},
		{
			"name": "keyword.operator.word.janitor",
			"match": "(?<![\\w$])(?:and|or|not|in)(?![\\w$])"
		},
		{
			"name": "keyword.other.janitor",
			"match": "(?<![\\w$])(?:import|as)(?![\\w$])"
		},
		{
			"name": "constant.language.janitor",
			"match": "(?<![\\w$])(?:true|false|null)(?![\\w$])"
		},
		{
			"name": "variable.other.janitor",
			"match": "[\\w$]+"
		},
		{
			"name": "keyword.operator.janitor",
			"match": "->|\\*\\*|\\+\\+|--|[-+*/%]=|==|!=|<>|<=|>=|~=|!~|&&|\\|\\||[-+*/%<>=!~]"
		},
		{
			"name": "punctuation.separator.janitor",
			"match": "[?:,;.]"
		},
		{
			"name": "punctuation.definition.janitor",
			"match": "[{}()\\[\\]]"
		}
	]
}
